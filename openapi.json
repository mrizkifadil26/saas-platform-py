    "/registrations/password": {
      "post": {
        "tags": [
          "registrations"
        ],
        "summary": "Set Password",
        "operationId": "set_password_registrations_password_post",
        "parameters": [
          {
            "name": "registration_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
