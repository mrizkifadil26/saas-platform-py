  "components": {
    "schemas": {
      "BeginEmailRegistrationRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "BeginEmailRegistrationRequest"
      },
      "BeginEmailRegistrationResponse": {
        "properties": {
          "method": {
            "type": "string",
            "title": "Method"
          },
          "step": {
            "type": "string",
            "title": "Step"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "method",
          "step",
          "expires_at"
        ],
        "title": "BeginEmailRegistrationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SetRegistrationPasswordRequest": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "password_confirmation": {
            "type": "string",
            "title": "Password Confirmation"
          }
        },
        "type": "object",
        "required": [
          "password",
          "password_confirmation"
        ],
        "title": "SetRegistrationPasswordRequest"
      },
      "SetRegistrationPasswordResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "SetRegistrationPasswordResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerifyEmailRegistrationLinkRequest": {
        "properties": {
          "token": {
            "type": "string",
            "minLength": 32,
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "VerifyEmailRegistrationLinkRequest"
      },
      "VerifyEmailRegistrationOtpRequest": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 6,
            "minLength": 6,
            "pattern": "^\\d{6}$",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "VerifyEmailRegistrationOtpRequest"
      },
      "VerifyEmailRegistrationResponse": {
        "properties": {
          "method": {
            "type": "string",
            "title": "Method"
          },
          "step": {
            "type": "string",
            "title": "Step"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "method",
          "step",
          "expires_at"
        ],
        "title": "VerifyEmailRegistrationResponse"
      }
    }
