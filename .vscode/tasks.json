{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "svc: mypy",
            "type": "shell",
            "command": "poetry run mypy .",
            "options": {
                "cwd": "${workspaceFolder}/${input:servicePath}"
            },
            "group": "test"
        }
    ],
    "inputs": [
        {
            "id": "servicePath",
            "type": "pickString",
            "description": "Select service/package",
            "options": [
                "packages/db",
                "services/api",
                "services/worker"
            ],
            "default": "services/api"
        }
    ]
}